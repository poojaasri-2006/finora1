# CashShield Environment Variables
# Copy this file to .env and fill in your values.

# Database
# For local development (SQLite — no server needed):
DATABASE_URL="file:./dev.db"
# For production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@localhost:5432/cashshield?schema=public"

# Next.js
NEXT_PUBLIC_APP_NAME="CashShield"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth (placeholder — implement your auth provider here)
# NEXTAUTH_SECRET="your-secret-here"
# NEXTAUTH_URL="http://localhost:3000"

# Feature flags
ENABLE_MOCK_INTEGRATIONS="true"

# Aczen Nova API (server-side only; never prefix with NEXT_PUBLIC_)
# Generate a team key at https://www.aczen.in/nova-api and keep it out of Git.
NOVA_API_KEY=""
# Required when this deployment contains more than one organization.
# Use the organization id returned by the authenticated /api/settings endpoint.
NOVA_ORGANIZATION_ID=""
